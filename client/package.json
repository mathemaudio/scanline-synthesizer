{
  "name": "scanline-synthesizer-client",
  "version": "0.1.4",
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit --watch",
    "typecheck:pages": "tsc -p tsconfig.pages.json",
    "dev": "node scripts/dev-with-emit.mjs",
    "dev:vite": "vite",
    "dev:emit": "tsc -w --preserveWatchOutput",
    "lll-server": "evidyts --server start --port 47033 --projectPath . --projectClientLink http://localhost:47031",
    "lll-check": "tsc --preserveWatchOutput && evidyts --project tsconfig.json --entry src/Start.lll.ts --clientTunnel http://localhost:47033 --noEmit",
    "build": "tsc && vite build",
    "build:pages": "pnpm run typecheck:pages && vite build",
    "preview": "vite preview",
    "i": "pnpm i"
  },
  "dependencies": {
    "lit": "^3.2.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "lllts": "file:../.lll/vendor/lllts"
  }
}
